{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lockfileVersion": {
      "type": "number",
      "const": 1
    },
    "endpoints": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:GET|POST) \\S+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "observed": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "protocol": {
                    "type": "string",
                    "const": "x402"
                  },
                  "x402Version": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "resourceUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "envelopeIntegrity": {
                    "type": "string",
                    "pattern": "^sha256-[A-Za-z0-9+/]{43}=$"
                  },
                  "options": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "scheme": {
                          "type": "string",
                          "pattern": "^[\\x21-\\x7e]+$"
                        },
                        "network": {
                          "type": "string",
                          "pattern": "^[\\x21-\\x7e]+$"
                        },
                        "asset": {
                          "type": "string",
                          "pattern": "^[\\x21-\\x7e]+$"
                        },
                        "payTo": {
                          "type": "string",
                          "pattern": "^[\\x21-\\x7e]+$"
                        },
                        "amount": {
                          "type": "string",
                          "pattern": "^(?:0|[1-9][0-9]{0,77})$"
                        },
                        "maxTimeoutSeconds": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "paymentFlow": {
                          "type": "string",
                          "enum": [
                            "authorization",
                            "upfront",
                            "escrow"
                          ]
                        },
                        "assetTransferMethod": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "extra": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "$ref": "#/$defs/__schema0"
                          }
                        },
                        "otherFields": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "$ref": "#/$defs/__schema0"
                          }
                        },
                        "integrity": {
                          "type": "string",
                          "pattern": "^sha256-[A-Za-z0-9+/]{43}=$"
                        }
                      },
                      "required": [
                        "scheme",
                        "network",
                        "asset",
                        "payTo",
                        "amount",
                        "maxTimeoutSeconds",
                        "paymentFlow",
                        "assetTransferMethod",
                        "extra",
                        "otherFields",
                        "integrity"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "protocol",
                  "x402Version",
                  "resourceUrl",
                  "envelopeIntegrity",
                  "options"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "protocol": {
                    "type": "string",
                    "const": "mpp"
                  },
                  "resourceUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "envelopeIntegrity": {
                    "type": "string",
                    "pattern": "^sha256-[A-Za-z0-9+/]{43}=$"
                  },
                  "options": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "scheme": {
                          "type": "string",
                          "pattern": "^[\\x21-\\x7e]+$"
                        },
                        "network": {
                          "type": "string",
                          "pattern": "^[\\x21-\\x7e]+$"
                        },
                        "asset": {
                          "type": "string",
                          "pattern": "^[\\x21-\\x7e]+$"
                        },
                        "payTo": {
                          "type": "string",
                          "pattern": "^[\\x21-\\x7e]+$"
                        },
                        "amount": {
                          "type": "string",
                          "pattern": "^(?:0|[1-9][0-9]{0,77})$"
                        },
                        "maxTimeoutSeconds": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "paymentFlow": {
                          "type": "string",
                          "enum": [
                            "authorization",
                            "upfront",
                            "escrow"
                          ]
                        },
                        "assetTransferMethod": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "extra": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "$ref": "#/$defs/__schema0"
                          }
                        },
                        "otherFields": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "$ref": "#/$defs/__schema0"
                          }
                        },
                        "integrity": {
                          "type": "string",
                          "pattern": "^sha256-[A-Za-z0-9+/]{43}=$"
                        }
                      },
                      "required": [
                        "scheme",
                        "network",
                        "asset",
                        "payTo",
                        "amount",
                        "maxTimeoutSeconds",
                        "paymentFlow",
                        "assetTransferMethod",
                        "extra",
                        "otherFields",
                        "integrity"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "protocol",
                  "resourceUrl",
                  "envelopeIntegrity",
                  "options"
                ],
                "additionalProperties": false
              }
            ]
          },
          "policy": {
            "type": "object",
            "properties": {
              "options": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "maxAmount": {
                      "type": "string",
                      "pattern": "^(?:0|[1-9][0-9]{0,77})$"
                    }
                  },
                  "required": [
                    "maxAmount"
                  ],
                  "additionalProperties": false
                }
              },
              "tighten": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "TERMS_CHANGED_OTHER",
                    "NEW_OPTION_OFFERED",
                    "ENDPOINT_NOT_402",
                    "PROBE_TIMEOUT",
                    "PROTOCOL_VERSION_CHANGED",
                    "OPTION_REMOVED"
                  ]
                }
              },
              "allowPrivateNetwork": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "options"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "observed",
          "policy"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "lockfileVersion",
    "endpoints"
  ],
  "additionalProperties": false,
  "title": "paid.lock v1",
  "description": "Lockfile pinning the payment terms of paid HTTP endpoints. Cross-field rules (identity keys, integrity, EIP-55, policy coverage) are in docs/LOCK_FORMAT.md.",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
