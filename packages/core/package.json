{
  "name": "@paid-lock/core",
  "version": "0.1.0",
  "private": false,
  "description": "Pure core of paid.lock: lock format, canonical hashing, diff and verdicts. No I/O.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metafrogmeme-droid/paid-lock.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/metafrogmeme-droid/paid-lock#readme",
  "bugs": "https://github.com/metafrogmeme-droid/paid-lock/issues",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "@paid-lock/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
