{
  "name": "paid-lock",
  "version": "0.1.0",
  "private": false,
  "description": "paid-lock CLI: pin the paid endpoints your agent calls in a reviewed lockfile.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metafrogmeme-droid/paid-lock.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/metafrogmeme-droid/paid-lock#readme",
  "bugs": "https://github.com/metafrogmeme-droid/paid-lock/issues",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "@paid-lock/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@paid-lock/core": "workspace:*",
    "@paid-lock/probe": "workspace:*",
    "@paid-lock/protocols": "workspace:*"
  },
  "bin": {
    "paid-lock": "./dist/bin.js"
  },
  "devDependencies": {
    "@paid-lock/mock-seller": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
