{
  "name": "@paid-lock/probe",
  "version": "0.1.0",
  "private": false,
  "description": "Unpaid HTTP probe for paid endpoints. Never sends a payment header and never loads a key.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metafrogmeme-droid/paid-lock.git",
    "directory": "packages/probe"
  },
  "homepage": "https://github.com/metafrogmeme-droid/paid-lock#readme",
  "bugs": "https://github.com/metafrogmeme-droid/paid-lock/issues",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "@paid-lock/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@paid-lock/core": "workspace:*",
    "@paid-lock/protocols": "workspace:*"
  },
  "devDependencies": {
    "@paid-lock/mock-seller": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
