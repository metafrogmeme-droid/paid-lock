{
  "name": "paid-lock-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tooling.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "copy-lint": "node scripts/copy-lint.ts",
    "check:deps": "node scripts/check-deps.ts",
    "check:never-pays": "node scripts/check-never-pays.ts",
    "check:guard-reach": "node scripts/check-guard-reach.ts",
    "gitleaks:selftest": "bash scripts/gitleaks-selftest.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "mock-seller": "node fixtures/mock-seller/src/main.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm copy-lint && pnpm check:deps && pnpm check:never-pays && pnpm check:guard-reach && pnpm smoke:mock-seller",
    "smoke:mock-seller": "node scripts/smoke-mock-seller.ts",
    "gen:schema": "node scripts/gen-lock-schema.ts",
    "demo": "pnpm build && node scripts/demo.ts",
    "build:action": "node scripts/build-action.ts",
    "check:action-dist": "node scripts/build-action.ts && git ls-files --error-unmatch action/dist/index.mjs >/dev/null && git diff --exit-code -- action/dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "fast-check": "^4.0.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.50.0",
    "vitest": "^5.0.0"
  }
}
